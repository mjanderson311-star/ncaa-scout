# Copy this file to .env and fill in your PostgreSQL credentials
# The app will auto-create the ncaa_scout database — no need to run createdb

# Full connection string (recommended):
DATABASE_URL=postgresql://postgres:yourpassword@localhost/ncaa_scout

# --- OR --- set individual variables:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=ncaa_scout

# Admin password — protects the Admin page and all scraping endpoints
ADMIN_PASSWORD=yourpassword

# Web server port (default 3001)
# PORT=3001
